# Copy this file to .env and fill in your values.
# .env is gitignored and will be loaded automatically by pono at startup.

# Solana RPC endpoint.
# A private node or a paid RPC (Helius, Triton, QuickNode) is strongly
# recommended — the public endpoint is heavily rate-limited and will cause
# frequent fetch failures during block streaming.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Birdeye API key for historical token prices.
# Required for accurate profit calculations on any token beyond SOL.
# Sign up at https://birdeye.so — the free tier is sufficient for development.
BIRDEYE_API_KEY=

# Log level (optional). Examples: info, debug, warn, pono=debug
RUST_LOG=info
